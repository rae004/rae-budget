# 7-day cooldown on any package version before pnpm will install it
# (10080 minutes = 7 * 24 * 60). Defense-in-depth alongside Dependabot's
# cooldown — this catches manual `pnpm install <pkg>` flows too.
minimum-release-age=10080

# Match pnpm's strict resolution to npm's flat behavior just enough to
# not break callers that import phantom transitive deps. Re-evaluate
# (turn off) if we never trip it.
shamefully-hoist=false
strict-peer-dependencies=false